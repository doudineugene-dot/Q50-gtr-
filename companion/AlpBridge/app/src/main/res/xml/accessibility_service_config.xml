<?xml version="1.0" encoding="utf-8"?>
<!--
  Служба ничего не читает с экрана и ничего не слушает сама по себе: она
  только исполняет жест по координатам, которые ей передаёт MirrorService, и
  то — при выключенном по умолчанию флаге (см. docs/ALP-CONTROL.md, третий
  этап). canRetrieveWindowContent не включается: содержимое окна ALP3 этой
  службе не нужно.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/label_control"
    android:notificationTimeout="100" />
