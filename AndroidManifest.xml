<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.q50gtr.plus"
    android:versionCode="7"
    android:versionName="0.8.4-bt">

    <uses-sdk android:minSdkVersion="9" android:targetSdkVersion="10" />

    <!-- чтение сигналов CAN (сенсоры VS_ID_*); dangerous -> авто-выдача на API 10 -->
    <uses-permission android:name="com.ygomi.permission.IVI_CAN_READ" />
    <!-- диагностический отчёт на флешку: в машине adb может не быть -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!--
        Связь с адаптером EcuTek EVI. BLUETOOTH — состояние адаптера, список
        сопряжённых и RFCOMM; BLUETOOTH_ADMIN — поиск в эфире. Обоих хватает
        на API 10; ничего сверх чтения здесь не требуется.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!--
        aapt выводит эту фичу как ОБЯЗАТЕЛЬНУЮ из разрешения BLUETOOTH. Если
        оставить так, ГУ без объявленного Bluetooth откажется ставить пакет —
        а приборы работают и без EcuTek, на штатном CAN.
    -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher">

        <!--
            Флаги оболочки InTouch. Ярлык на домашнем экране ГУ даёт именно
            ivi.shortcut: без него пакет виден только в AppManager — ровно то,
            что мы и наблюдали. Набор сверен с qazwsd147/appgarage-dash,
            приложением, которое на этом же ГУ ярлык получает.
        -->
        <meta-data android:name="ivi.shortcut" android:value="true" />
        <!-- не «отвлекающее» -> доступно на ходу -->
        <meta-data android:name="ivi.isDistractive" android:value="false" />
        <meta-data android:name="ivi.audio" android:value="false" />
        <meta-data android:name="ivi.autorun" android:value="false" />
        <meta-data android:name="ivi.Disclaimer" android:value="false" />
        <meta-data android:name="ivi.supportDisplay" android:value="ALL" />
        <!-- приборы живут на нижнем дисплее -->
        <meta-data android:name="ivi.defaultDisplay" android:value="LOWER" />

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:icon="@drawable/ic_launcher"
            android:keepScreenOn="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|navigation|keyboard"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
